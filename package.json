{
  "name": "visual-programming-chinese",
  "displayName": "代码可视化编程",
  "description": "将React和Rust代码转换为中文可视化工作流，支持拖拽操作",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "visualProgramming.openVisualView",
        "title": "打开可视化视图",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.analyzeCode",
        "title": "分析代码结构",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.openInteractiveCanvas",
        "title": "🎨 打开交互式画布",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.generateCode",
        "title": "✨ 智能代码生成",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.startRealtimeMonitoring",
        "title": "🔄 启动实时监控",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.aiAnalysis",
        "title": "🧠 AI 代码分析",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.createFromTemplate",
        "title": "🚀 从模板创建项目",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.openUnifiedVisualization",
        "title": "🎨 统一可视化工作台",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.openCodeOptimizer",
        "title": "🔧 智能代码优化",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.quickOptimize",
        "title": "⚡ 快速优化代码",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.generateQualityReport",
        "title": "📊 生成质量报告",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.runProjectDiagnostics",
        "title": "🏥 项目功能诊断",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.openBlueprintEditor",
        "title": "🎨 蓝图可视化编辑器",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.startRealTimeSync",
        "title": "🔄 启动实时代码同步",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.createFromEnhancedTemplate",
        "title": "📋 增强模板生成",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.configureInteraction",
        "title": "🎨 交互设置",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.enhancedCodeGeneration",
        "title": "🚀 增强代码生成",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.aiEnhancedAnalysis",
        "title": "🧠 AI增强分析",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.performanceAnalysis",
        "title": "⚡ 性能分析",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.switchTheme",
        "title": "🎨 切换主题",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.intelligentRefactor",
        "title": "🔧 智能重构",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.showOptimizationConfig",
        "title": "⚙️ 优化配置",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.showDiagnostics",
        "title": "🏥 系统诊断",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.clearCache",
        "title": "🗑️ 清理缓存",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.autoOptimizeProject",
        "title": "🚀 自动优化项目",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.openInteractiveCanvasSystem",
        "title": "🖼️ 交互式画布",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.openAnalysisVisualization",
        "title": "📊 分析结果可视化",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.createNodesFromAnalysis",
        "title": "🎨 从代码创建节点",
        "category": "代码可视化"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visualProgramming",
          "title": "代码可视化",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "visualProgramming": [
        {
          "id": "codeStructure",
          "name": "代码结构",
          "when": "true",
          "icon": "$(symbol-structure)"
        },
        {
          "id": "visualWorkflow",
          "name": "可视化工作流",
          "when": "true",
          "icon": "$(graph-line)"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .ts || resourceExtname == .tsx || resourceExtname == .js || resourceExtname == .jsx || resourceExtname == .rs",
          "command": "visualProgramming.analyzeCode",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test-backend": "npm run compile && echo 'Testing Rust backend architecture analysis...' && code --extensionDevelopmentPath=. ./demo",
    "test-advanced": "npm run compile && echo 'Testing advanced analysis features...' && code --extensionDevelopmentPath=. ./demo",
    "test-deep-optimization": "npm run compile && echo 'Testing deep optimization analysis...' && code --extensionDevelopmentPath=. ./demo"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "16.x",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.74.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "esbuild": "^0.17.11",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^5.45.0",
    "diff": "^8.0.2",
    "lodash": "^4.17.21",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  }
}
