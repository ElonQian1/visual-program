{
  "name": "visual-programming-chinese",
  "displayName": "代码可视化编程",
  "description": "将React和Rust代码转换为中文可视化工作流，支持拖拽操作",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "visualProgramming.openVisualView",
        "title": "打开可视化视图",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.analyzeCode",
        "title": "分析代码结构",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.openInteractiveCanvas",
