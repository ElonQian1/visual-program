        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.quickOptimize",
        "title": "⚡ 快速优化代码",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.generateQualityReport",
        "title": "📊 生成质量报告",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.runProjectDiagnostics",
        "title": "🏥 项目功能诊断",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.openBlueprintEditor",
        "title": "🎨 蓝图可视化编辑器",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.startRealTimeSync",
        "title": "🔄 启动实时代码同步",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.createFromEnhancedTemplate",
        "title": "📋 增强模板生成",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.configureInteraction",
        "title": "🎨 交互设置",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.enhancedCodeGeneration",
        "title": "🚀 增强代码生成",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.aiEnhancedAnalysis",
        "title": "🧠 AI增强分析",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.performanceAnalysis",
