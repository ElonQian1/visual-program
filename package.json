        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.startRealtimeMonitoring",
        "title": "🔄 启动实时监控",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.aiAnalysis",
        "title": "🧠 AI 代码分析",
        "category": "代码可视化"
      },
      {
        "command": "visualProgramming.createFromTemplate",
